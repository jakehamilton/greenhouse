;; Bump Allocator
;;
;; This file handles management of a simple bump allocator over the ~500MiB heap
;; for the program. At no point does it free anything, so it is possible to run
;; out of memory if you aren't careful. To allocate memory, call the `allocate`
;; function, passing in the number of bytes you need allocated via `rdi`.

;; Allocate
;;
;; Request an amount of bytes to allocate and receive a pointer to the start of
;; the allocated region.
;;
;; Input:
;; - `rdi`: the number of bytes to allocate
;;
;; Returns:
;; - `rax`: address to the start of allocated memory

:10 ; allocate

; Make the size a multiple of 8
A 8 0 7 07              ; add rdi, 7
B 2 rf1                 ; jb out_of_memory
A 8 4 7 f8              ; and rdi, -8

; Get the current heap cursor
M 8 1 3                 ; mov rcx, rbx
L 8 0 1                 ; mov rax, qword [rcx]

; Calculate the updated cursor
M 8 2 0                 ; mov rdx, rax
C 8 0 2 7               ; add rdx, rdi
B 2 rf1                 ; jb out_of_memory

; Calculate the heap end
M 8 1 3                 ; mov rcx, rbx
A 8 0 1 08              ; add rcx, 8
L 8 1 1                 ; mov rcx, qword [rcx]

; Handle overflow
C 8 7 2 1               ; cmp rdx, rcx
B 7 rf1                 ; ja out_of_memory

; Set the updated cursor in context
S 8 3 2                 ; mov qword [rbx], rdx
R                       ; ret
