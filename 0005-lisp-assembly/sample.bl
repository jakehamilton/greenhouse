; vim: set ft=lisp :

;; This file contains a sample program which uses Lisp Assembly to build and
;; write a native binary. Use the following command to build this file:
;;
;; cat ../0004-bootstrap-lisp/src/prelude.bl ./src/asm.bl ./sample.bl |\
;;   ../0004-bootstrap-lisp/bootstrap-lisp > ./sample
;;
;; And then execute the compiled program:
;;
;; ./sample

(let sample/success-message "assembly self-test passed\n")
(let sample/failure-message "assembly self-test failed\n")

(let sample/expect-rax
  (fn (expected code)
      (list
        (asm/move code asm/edi)
        (asm/move expected asm/r11)
        (asm/compare asm/r11 asm/rax)
        (asm/jump-when 'not-equal 'sample/failed))))

(let sample/fill-and-sum
  (fn (count)
      ((fn (loop-label)
           (list
             (asm/move asm/r12 asm/rdi)
             (asm/move count asm/r8)
             (asm/move 0x1 asm/r9)
             (asm/move 0x8 asm/r10)
             (asm/xor asm/rax asm/rax)
             (asm/label loop-label)
             (asm/move asm/r8 (asm/memory asm/rdi 0x0))
             (asm/move (asm/memory asm/rdi 0x0) asm/rdx)
             (asm/add asm/rdx asm/rax)
             (asm/add asm/r10 asm/rdi)
             (asm/subtract asm/r9 asm/r8)
             (asm/test asm/r8 asm/r8)
             (asm/jump-when 'not-equal loop-label)))
       (asm/create-label))))

(let sample/widening-checks
  (list
    (asm/move 0x80 asm/r8b)
    (asm/move-sign-extended asm/r8b asm/rax)
    (sample/expect-rax -0x80 0x02)
    (asm/move-zero-extended asm/r8b asm/rax)
    (sample/expect-rax 0x80 0x03)
    (asm/move 0x8001 asm/r9w)
    (asm/move-sign-extended asm/r9w asm/rax)
    (sample/expect-rax -0x7fff 0x04)
    (asm/move-zero-extended asm/r9w asm/rax)
    (sample/expect-rax 0x8001 0x05)
    (asm/move 0x80000001 asm/r10d)
    (asm/move-sign-extended asm/r10d asm/rax)
    (sample/expect-rax -0x7fffffff 0x06)
    (asm/move-zero-extended asm/r10d asm/rax)
    (sample/expect-rax 0x80000001 0x07)
    (asm/move 0xfe asm/dil)
    (asm/invert asm/dil)
    (asm/negate asm/dil)
    (asm/move asm/dil (asm/memory asm/r13 -0x1))
    (asm/move-sign-extended (asm/sized-memory asm/r13 -0x1 0x1) asm/rax)
    (sample/expect-rax -0x1 0x08)
    (asm/move-zero-extended (asm/sized-memory asm/r13 -0x1 0x1) asm/rax)
    (sample/expect-rax 0xff 0x09)
    (asm/move asm/r9w (asm/memory asm/r12 0x20))
    (asm/xor asm/rax asm/rax)
    (asm/move (asm/memory asm/r12 0x20) asm/ax)
    (sample/expect-rax 0x8001 0x0a)
    (asm/move-sign-extended (asm/sized-memory asm/r12 0x20 0x2) asm/rax)
    (sample/expect-rax -0x7fff 0x0b)
    (asm/move asm/r10d (asm/memory asm/r12 0x24))
    (asm/move-sign-extended (asm/sized-memory asm/r12 0x24 0x4) asm/rax)
    (sample/expect-rax -0x7fffffff 0x0c)
    (asm/move-zero-extended (asm/sized-memory asm/r12 0x24 0x4) asm/rax)
    (sample/expect-rax 0x80000001 0x0d)))

(let sample/arithmetic-checks
  (list
    (asm/move 0x64 asm/rax)
    (asm/move asm/rax (asm/memory asm/r12 0x28))
    (asm/move 0x7 asm/rcx)
    (asm/add asm/rcx (asm/memory asm/r12 0x28))
    (asm/move (asm/memory asm/r12 0x28) asm/rax)
    (sample/expect-rax 0x6b 0x0e)
    (asm/subtract asm/rcx (asm/memory asm/r12 0x28))
    (asm/move 0x17 asm/rax)
    (asm/add (asm/memory asm/r12 0x28) asm/rax)
    (sample/expect-rax 0x7b 0x0f)
    (asm/subtract (asm/memory asm/r12 0x28) asm/rax)
    (sample/expect-rax 0x17 0x10)
    (asm/move -0x3 asm/rax)
    (asm/multiply (asm/memory asm/r12 0x28) asm/rax)
    (sample/expect-rax -0x12c 0x11)
    (asm/negate asm/rax)
    (asm/move 0x3 asm/r8)
    (asm/multiply asm/r8 asm/rax)
    (sample/expect-rax 0x384 0x12)
    (asm/move 0xf0f0 asm/r8)
    (asm/move asm/r8 (asm/memory asm/r12 0x30))
    (asm/move 0x0ff0 asm/r9)
    (asm/and asm/r9 (asm/memory asm/r12 0x30))
    (asm/move (asm/memory asm/r12 0x30) asm/rax)
    (sample/expect-rax 0xf0 0x13)
    (asm/or asm/r9 (asm/memory asm/r12 0x30))
    (asm/move (asm/memory asm/r12 0x30) asm/rax)
    (sample/expect-rax 0xff0 0x14)
    (asm/xor asm/r9 (asm/memory asm/r12 0x30))
    (asm/move (asm/memory asm/r12 0x30) asm/rax)
    (sample/expect-rax 0x0 0x15)
    (asm/invert asm/rax)
    (sample/expect-rax -0x1 0x16)
    (asm/move -0x11 asm/rax)
    (asm/move 0x5 asm/rcx)
    (asm/divide-signed asm/rcx asm/rax)
    (sample/expect-rax -0x3 0x17)
    (asm/move asm/rdx asm/rax)
    (sample/expect-rax -0x2 0x18)
    (asm/move -0x1 asm/rax)
    (asm/move 0x10 asm/rcx)
    (asm/divide-unsigned asm/rcx asm/rax)
    (sample/expect-rax 0xfffffffffffffff 0x19)
    (asm/move asm/rdx asm/rax)
    (sample/expect-rax 0xf 0x1a)
    (asm/move 0x5 asm/rcx)
    (asm/move asm/rcx (asm/memory asm/r12 0x38))
    (asm/move 0x11 asm/rax)
    (asm/divide-signed (asm/memory asm/r12 0x38) asm/rax)
    (sample/expect-rax 0x3 0x1b)
    (asm/move asm/rdx asm/rax)
    (sample/expect-rax 0x2 0x1c)))

(let sample/shift-and-flag-checks
  (list
    (asm/move -0x18 asm/rax)
    (asm/shift-right-arithmetic asm/rax 0x3)
    (sample/expect-rax -0x3 0x1d)
    (asm/shift-left asm/rax 0x3)
    (sample/expect-rax -0x18 0x1e)
    (asm/move 0x12340 asm/rax)
    (asm/move 0x4 asm/ecx)
    (asm/shift-right-logical asm/rax asm/cl)
    (sample/expect-rax 0x1234 0x1f)
    (asm/shift-left asm/rax asm/cl)
    (sample/expect-rax 0x12340 0x20)
    (asm/move -0x18 asm/rax)
    (asm/move 0x3 asm/ecx)
    (asm/shift-right-arithmetic asm/rax asm/cl)
    (sample/expect-rax -0x3 0x21)
    (asm/move 0x80 asm/al)
    (asm/shift-right-logical asm/al 0x1)
    (asm/move-zero-extended asm/al asm/rax)
    (sample/expect-rax 0x40 0x22)
    (asm/move -0x1 asm/rax)
    (asm/move 0x1 asm/rcx)
    (asm/move 0x23 asm/edi)
    (asm/compare asm/rcx asm/rax)
    (asm/jump-when 'greater-or-equal 'sample/failed)
    (asm/jump-when 'below-or-equal 'sample/failed)
    (asm/move 0x1 asm/rax)
    (asm/shift-left asm/rax 0x3f)
    (asm/move 0x24 asm/edi)
    (asm/negate asm/rax)
    (asm/jump-when 'not-overflow 'sample/failed)
    (asm/move 0x7 asm/r8)
    (asm/move asm/r8 (asm/memory asm/r12 0x40))
    (asm/move 0x8 asm/rcx)
    (asm/move 0x25 asm/edi)
    (asm/test asm/rcx (asm/memory asm/r12 0x40))
    (asm/jump-when 'not-equal 'sample/failed)
    (asm/move 0x2 asm/rcx)
    (asm/test (asm/memory asm/r12 0x40) asm/rcx)
    (asm/jump-when 'equal 'sample/failed)))

(let sample/stack-and-call-checks
  (list
    (asm/move 0x11 asm/rbx)
    (asm/move 0x22 asm/r14)
    (asm/push asm/rbx asm/r14)
    (asm/move (asm/memory asm/rsp 0x0) asm/rax)
    (sample/expect-rax 0x22 0x26)
    (asm/move (asm/memory asm/rsp 0x8) asm/rax)
    (sample/expect-rax 0x11 0x27)
    (asm/xor asm/rbx asm/rbx)
    (asm/xor asm/r14 asm/r14)
    (asm/pop asm/r14 asm/rbx)
    (asm/move asm/rbx asm/rax)
    (asm/add asm/r14 asm/rax)
    (sample/expect-rax 0x33 0x28)
    (asm/call 'sample/sum-32)
    (sample/expect-rax 0x210 0x29)
    (asm/address 'sample/sum-9 asm/r10)
    (asm/call asm/r10)
    (sample/expect-rax 0x2d 0x2a)
    (asm/address 'sample/sum-32 asm/r10)
    (asm/move asm/r10 (asm/memory asm/r12 0x300))
    (asm/call (asm/memory asm/r12 0x300))
    (sample/expect-rax 0x210 0x2b)
    (asm/address 'sample/after-register-jump asm/r10)
    (asm/jump asm/r10)
    (asm/move 0x2c asm/edi)
    (asm/jump 'sample/failed)
    (asm/label 'sample/after-register-jump)
    (asm/address 'sample/constants asm/r13)
    (asm/move asm/r13 asm/rax)
    (asm/move 0xf asm/rcx)
    (asm/and asm/rcx asm/rax)
    (sample/expect-rax 0x0 0x2d)
    (asm/move (asm/memory asm/r13 0x0) asm/rax)
    (sample/expect-rax 0x123456789abcdef 0x2e)
    (asm/address 'sample/passed asm/r10)
    (asm/move asm/r10 (asm/memory asm/r12 0x308))
    (asm/jump (asm/memory asm/r12 0x308))))

(asm/build
  (asm/label 'main)
  (asm/raw 0x90)
  (asm/move 0x9 asm/eax)
  (asm/move 0x0 asm/edi)
  (asm/move 0x1000 asm/esi)
  (asm/move 0x3 asm/edx)
  (asm/move 0x22 asm/r10d)
  (asm/move -0x1 asm/r8)
  (asm/move 0x0 asm/r9d)
  (asm/syscall)
  (asm/move 0x1 asm/edi)
  (asm/move 0x0 asm/r11)
  (asm/compare asm/r11 asm/rax)
  (asm/jump-when 'less 'sample/failed)
  (asm/move asm/rax asm/r12)
  (asm/address (asm/memory asm/r12 0x80) asm/r13)
  (list
    sample/widening-checks
    (list sample/arithmetic-checks sample/shift-and-flag-checks)
    sample/stack-and-call-checks)
  (asm/label 'sample/passed)
  (asm/move 0xb asm/eax)
  (asm/move asm/r12 asm/rdi)
  (asm/move 0x1000 asm/esi)
  (asm/syscall)
  (sample/expect-rax 0x0 0x2f)
  (asm/move 0x1 asm/eax)
  (asm/move 0x1 asm/edi)
  (asm/address 'sample/success-text asm/rsi)
  (asm/move (byte-vector-length sample/success-message) asm/edx)
  (asm/syscall)
  (sample/expect-rax (byte-vector-length sample/success-message) 0x30)
  (asm/move 0x3c asm/eax)
  (asm/move 0x0 asm/edi)
  (asm/syscall)
  (asm/label 'sample/failed)
  (asm/move asm/edi asm/r15d)
  (asm/move 0x1 asm/eax)
  (asm/move 0x2 asm/edi)
  (asm/address 'sample/failure-text asm/rsi)
  (asm/move (byte-vector-length sample/failure-message) asm/edx)
  (asm/syscall)
  (asm/move asm/r15d asm/edi)
  (asm/move 0x3c asm/eax)
  (asm/syscall)
  (asm/align 0x10)
  (asm/label 'sample/sum-32)
  (sample/fill-and-sum 0x20)
  (asm/return)
  (asm/align 0x10)
  (asm/label 'sample/sum-9)
  (sample/fill-and-sum 0x9)
  (asm/return)
  (asm/align 0x10)
  (asm/label 'sample/constants)
  (asm/value 0x123456789abcdef 0x8)
  (asm/label 'sample/success-text)
  (asm/bytes sample/success-message)
  (asm/label 'sample/failure-text)
  (asm/bytes sample/failure-message))
